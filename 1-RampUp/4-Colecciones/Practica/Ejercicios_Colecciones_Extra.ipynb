    "while True:\n",
    "    opcion = int(input(\"Elige una opción: 1 - Visualizar libros, 2 - Añadir libro, 3 - Eliminar libro, 4 - Buscar libro, 5 - Alquilar libro, 6 - Devolver libro, 7 - Salir\"))\n",
    "\n",
    "    match opcion:\n",
    "        case 1:\n",
    "            for libro in libros:\n",
    "                print(libro[\"Titulo\"], \"|\", libro[\"Autor\"], \"|\", \"Alquilado:\", libro[\"Alquilado\"])\n",
    "        case 2:\n",
    "            titulo = input(\"Introduce el título: \").strip()\n",
    "            autor = input(\"Introduce el autor: \").strip()\n",
    "            libros.append({\"Titulo\": titulo, \"Autor\": autor, \"Alquilado\": False})\n",
    "            print(\"Libro añadido\")\n",
    "        case 3:\n",
    "            titulo = input(\"Título del libro a eliminar: \").lower().strip()\n",
    "            for libro in libros:\n",
    "                if libro[\"Titulo\"].lower().strip() == titulo:\n",
    "                    libros.remove(libro)\n",
    "                    print(\"Libro eliminado\")\n",
    "                    break\n",
    "            else:\n",
    "                print(\"Libro no encontrado\")\n",
    "        case 4:\n",
    "            titulo = input(\"Título del libro a buscar: \").lower().strip()\n",
    "            for libro in libros:\n",
    "                if libro[\"Titulo\"].lower().strip() == titulo:\n",
    "                    print(\"Título:\", libro[\"Titulo\"])\n",
    "                    print(\"Autor:\", libro[\"Autor\"])\n",
    "                    print(\"Alquilado:\", libro[\"Alquilado\"])\n",
    "                    break\n",
    "            else:\n",
    "                print(\"Libro no encontrado\")\n",
    "        case 5:\n",
    "            titulo = input(\"Título del libro a alquilar: \").lower().strip()\n",
    "            for libro in libros:\n",
    "                if libro[\"Titulo\"].lower().strip() == titulo:\n",
    "                    if libro[\"Alquilado\"]:\n",
    "                        print(\"El libro ya está alquilado\")\n",
    "                    else:\n",
    "                        libro[\"Alquilado\"] = True\n",
    "                        print(\"Libro alquilado\")\n",
    "                    break\n",
    "            else:\n",
    "                print(\"Libro no encontrado\")\n",
    "        case 6:\n",
    "            titulo = input(\"Título del libro a devolver: \").lower().strip()\n",
    "            for libro in libros:\n",
    "                if libro[\"Titulo\"].lower().strip() == titulo:\n",
    "                    if not libro[\"Alquilado\"]:\n",
    "                        print(\"El libro no estaba rentado\")\n",
    "                    else:\n",
    "                        libro[\"Alquilado\"] = False\n",
    "                        print(\"Libro devuelto\")\n",
    "                    break\n",
    "            else:\n",
    "                print(\"Libro no encontrado\")\n",
    "        case 7:\n",
    "            print(\"Fin del programa\")\n",
    "            break\n",
    "        case _:\n",
    "            print(\"Opción no valida\")"
